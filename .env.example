# AgentProbe -- environment variables
# Copy to .env and fill in your values.
# All services below are free tier -- no credit card required.

# -------------------------------------------------------------------------
# Required
# -------------------------------------------------------------------------

# Groq -- free at console.groq.com (no CC required)
GROQ_API_KEY=gsk_...

# Neon Postgres -- free at neon.tech (run infra/schema.sql once to init)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/agentprobe?sslmode=require

# -------------------------------------------------------------------------
# Optional but strongly recommended for production
# -------------------------------------------------------------------------

# Upstash Redis -- free at upstash.com
# Used for: leaderboard caching, SSE event polling cache, rate limit state
# Without this, caching is disabled (API still works, just slower under load)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Internal auth between API and workers. Set to a random 32-char string.
# Generate one: python -c "import secrets; print(secrets.token_hex(16))"
WORKER_SECRET=change-me-to-random-string

# GitHub PAT with repo + workflow scopes -- for dispatching audit workers.
# If not set, audits run in-process (fine for local dev, slower on Render).
GITHUB_PAT=ghp_...
GITHUB_OWNER=Aprameya05
GITHUB_REPO=agentprobe

# Your deployed API URL (Render gives this after deploy)
API_BASE_URL=https://agentprobe-api.onrender.com

# -------------------------------------------------------------------------
# Tuning (optional overrides)
# -------------------------------------------------------------------------

# Max POST body size in bytes (default 65536 = 64 KB)
MAX_REQUEST_BYTES=65536

# POST /audit rate limit per IP per minute (default 10)
RATE_LIMIT_PER_MIN=10

# CORS -- comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://agentprobe.pages.dev,http://localhost:3000

# Set to "1" to enable OpenAPI docs and expose error details (dev only)
DEBUG=
